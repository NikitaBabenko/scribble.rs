# No secrets, database, or external service are needed.
# The public proxy always listens on 8080; backend bind is fixed by start.sh.
LOBBY_SETTING_DEFAULTS_PUBLIC=false
LOBBY_SETTING_DEFAULTS_MAX_PLAYERS=8
LOBBY_SETTING_BOUNDS_MAX_MAX_PLAYERS=8
LOBBY_SETTING_DEFAULTS_CLIENTS_PER_IP_LIMIT=8
LOBBY_SETTING_BOUNDS_MAX_CLIENTS_PER_IP_LIMIT=8
# ROOT_URL/CANONICAL_URL are optional metadata only; leave ROOT_PATH unset.
# CORS_ALLOWED_ORIGINS may be set to the exact public HTTPS origin.
